# Which provider sendTicketEmail uses: 'gmail' or 'resend'.
EMAIL_PROVIDER=gmail

# Used when EMAIL_PROVIDER=gmail. GMAIL_APP_PASSWORD is set as a secret instead
# (firebase functions:secrets:set GMAIL_APP_PASSWORD), not here.
GMAIL_USER=

# Used when EMAIL_PROVIDER=resend. RESEND_API_KEY is set as a secret instead
# (firebase functions:secrets:set RESEND_API_KEY), not here.
TICKET_EMAIL_FROM=
