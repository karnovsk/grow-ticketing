VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional brand theme. Leave unset for the default look, or set to
# "habaronit" for the green/gold theme sampled from the venue's menu site.
VITE_THEME=

# Optional ISO 4217 currency code for amounts shown in the staff app
# (defaults to ILS when unset).
VITE_CURRENCY=

# Set to "true" to point this app at `firebase emulators:start` instead of
# production (same project id works for both — the emulator impersonates
# it locally). Put this in .env.development.local, NOT .env.local — Vite
# loads .env.local for every mode including `vite build`, so it would leak
# into production builds and point deployed auth calls at a local port that
# doesn't exist there.
VITE_USE_EMULATORS=
